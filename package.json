{
  "name": "@wedevelopnl/silverstripe-grid",
  "version": "6.0.0",
  "description": "Elemental grid module for SilverStripe",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run i18n:collect && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tests/E2E --noEmit",
    "lint": "biome lint . && stylelint 'client/src/**/*.scss'",
    "lint:js": "biome lint .",
    "lint:js:fix": "biome lint --write .",
    "lint:css": "stylelint 'client/src/**/*.scss'",
    "lint:css:fix": "stylelint 'client/src/**/*.scss' --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "i18n:collect": "node scripts/collect-js-i18n.mjs",
    "i18n:check": "node scripts/collect-js-i18n.mjs --dry-run && node scripts/check-i18n-parity.mjs",
    "check:icons": "node scripts/check-icon-classes.mjs",
    "qa": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run i18n:check && npm run check:icons && vite build",
    "mutate": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "docs:screenshots": "playwright test --config playwright.docs.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@tanstack/react-query": "^5.101.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "valibot": "^1.4.2"
  },
  "overrides": {
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.5.0",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "js-yaml": "^5.2.3",
    "jsdom": "^30.0.1",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vitest-fail-on-console": "^0.10.1"
  }
}
