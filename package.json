{
  "name": "@wedevelopnl/silverstripe-grid",
  "version": "6.0.0",
  "description": "Elemental grid module for SilverStripe",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run i18n:collect && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint client/src/ && stylelint 'client/src/**/*.scss'",
    "lint:js": "biome lint client/src/",
    "lint:js:fix": "biome lint --write client/src/",
    "lint:css": "stylelint 'client/src/**/*.scss'",
    "lint:css:fix": "stylelint 'client/src/**/*.scss' --fix",
    "format": "biome format --write client/src/",
    "format:check": "biome format client/src/",
    "i18n:collect": "node scripts/collect-js-i18n.mjs",
    "i18n:check": "node scripts/collect-js-i18n.mjs --dry-run && node scripts/check-i18n-parity.mjs",
    "qa": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run i18n:check && vite build",
    "mutate": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@tanstack/react-query": "^5.100.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.5.0",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.11.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
