{
  "name": "@wedevelopnl/silverstripe-grid",
  "version": "6.0.0",
  "description": "Elemental grid module for SilverStripe",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint client/src/ && stylelint 'client/src/**/*.scss'",
    "lint:js": "oxlint client/src/",
    "lint:js:fix": "oxlint --fix client/src/",
    "lint:css": "stylelint 'client/src/**/*.scss'",
    "lint:css:fix": "stylelint 'client/src/**/*.scss' --fix",
    "qa": "npm run lint && npm run typecheck && npm run test",
    "mutate": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@tanstack/react-query": "^5.95.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.5.0",
    "@stryker-mutator/typescript-checker": "^9.5.0",
    "@stryker-mutator/vitest-runner": "^9.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "oxlint": "^1.58.0",
    "sass-embedded": "^1.77.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.1"
  }
}
