<div data-grid-add-shared-block data-grid-leaf-types="$LeafTypes.ATT">
    <%-- Replaced by the React split button on mount; the stock link is what
         remains when the CMS bundle fails to load. --%>
    <a href="$NewLink" class="action action-detail btn btn-primary new new-link">
        <span class="font-icon-plus-circled btn__icon" aria-hidden="true"></span>
        <span class="btn__title">$ButtonName</span>
    </a>
</div>
