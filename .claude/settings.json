{
  "permissions": {
    "allow": [
      "Bash(docker compose -f .docker/compose.yml:*)",
      "WebFetch(domain:docs.silverstripe.org)"
    ],
    "deny": []
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/qa-gate.sh",
            "timeout": 300,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/e2e-granularity-check.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}
