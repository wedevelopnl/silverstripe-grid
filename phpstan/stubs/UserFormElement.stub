 * here as @method tags. Delete with the stand-in
 * (https://github.com/silverstripe/silverstripe-framework/issues/12030).
 *
 * @method \SilverStripe\CMS\Model\SiteTree RedirectPage()
 * @method string Link(string|bool|null $action = null)
 */
