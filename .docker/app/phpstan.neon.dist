parameters:
    level: max
    paths:
        - /module/src
    scanFiles:
        - /module/phpstan/stubs/DeleteLocalisationPolicy.stub
        - /module/phpstan/stubs/FluentIsolatedExtension.stub
        - /module/phpstan/stubs/FluentLocale.stub
        - /module/phpstan/stubs/FluentState.stub
    stubFiles:
        - /module/phpstan/stubs/AdminController.stub
        - /module/phpstan/stubs/ImageManipulation.stub
        - /module/phpstan/stubs/RecursivePublishable.stub
    type_coverage:
        return_type: 100
        param_type: 100
        property_type: 100
        constant_type: 100
        declare: 100
