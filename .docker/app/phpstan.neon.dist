parameters:
    level: max
    phpVersion:
        min: 80300
        max: 80599
    paths:
        - /module/src
    scanFiles:
        - /module/phpstan/stubs/AdminToolbar.stub
        - /module/phpstan/stubs/DeleteLocalisationPolicy.stub
        - /module/phpstan/stubs/FluentIsolatedExtension.stub
        - /module/phpstan/stubs/FluentLocale.stub
        - /module/phpstan/stubs/FluentState.stub
        - /module/phpstan/stubs/EditableFormField.stub
        - /module/phpstan/stubs/SubmittedForm.stub
        - /module/phpstan/stubs/UserDefinedFormController.stub
        - /module/phpstan/stubs/UserForm.stub
        - /module/phpstan/stubs/UserFormForm.stub
    stubFiles:
        - /module/phpstan/stubs/AdminController.stub
        - /module/phpstan/stubs/ImageManipulation.stub
        - /module/phpstan/stubs/RecursivePublishable.stub
        - /module/phpstan/stubs/UserFormElement.stub
    type_coverage:
        return_type: 100
        param_type: 100
        property_type: 100
        constant_type: 100
