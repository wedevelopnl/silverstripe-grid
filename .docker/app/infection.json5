{
    $schema: "vendor/infection/infection/resources/schema.json",
    source: {
        directories: ["/module/src"],
    },
    timeout: 30,
    logs: {
        text: "infection/infection.log",
        json: "infection/infection.json",
    },
    mutators: {
        "@default": true,
        // SilverStripe calls methods by name via reflection (extend, $dependencies, Injector).
        // Visibility changes don't break tests but would break the framework at runtime.
        "PublicVisibility": false,
        "ProtectedVisibility": false,
        "CastInt": {
            ignoreSourceCodeByRegex: [
                // PHP coerces numeric strings in arithmetic; explicit (int) cast documents intent
                ".*\\(int\\) \\$m\\[.num.\\].*",
                // SilverStripe ORM returns numeric strings for DB columns (ID, ParentID, Sort).
                // Explicit (int) is for PHPStan type narrowing, not runtime behavior — PHP
                // coerces transparently in arithmetic, array access, and comparisons.
                ".*\\(int\\)\\s*\\$\\w+->(?:ID|ParentID|Sort)\\b.*",
                ".*\\(int\\)\\s*\\$request->param\\(.*",
                // Form option values from integer array keys — cast documents type, not behavior
                ".*\\(int\\)\\s*\\$optionValue\\b.*",
                // DB aggregate results (->max('"Sort"')) return numeric strings
                ".*\\(int\\)\\s*\\$max\\b.*",
                // Raw SQL result arrays — same as ORM property casts above but via
                // array access. PHP coerces transparently; casts are for PHPStan.
                ".*\\(int\\)\\s*\\(?\\$row\\[.*",
            ],
        },
        "CastString": {
            ignoreSourceCodeByRegex: [
                // SilverStripe ORM string properties and request params — explicit (string)
                // cast is for PHPStan, not behavior. ORM already returns strings.
                ".*\\(string\\)\\s*\\$\\w+->(?:Title|Zone|ParentClass|ClassName)\\b.*",
                ".*\\(string\\)\\s*\\$request->param\\(.*",
                // Raw SQL result arrays — cast documents type for PHPStan, not behavior
                ".*\\(string\\)\\s*\\(?\\$row\\[.*",
            ],
        },
        "CastBool": {
            ignoreSourceCodeByRegex: [
                // Raw SQL result arrays — cast documents type for PHPStan
                ".*\\(bool\\)\\s*\\(?\\$row\\[.*",
                // Symfony Console getOption() for VALUE_NONE already returns bool;
                // explicit cast is for PHPStan type narrowing
                ".*\\(bool\\)\\s*\\$input->getOption\\(.*",
            ],
        },
        "TrueValue": {
            ignoreSourceCodeByRegex: [
                // Auto-scaffold config restoration in migration finally blocks —
                // process-global state invisible within a single test run
                ".*config\\(\\)->set\\('auto_scaffold'.*",
            ],
        },
        "Concat": {
            ignoreSourceCodeByRegex: [
                // i18n key concatenation: _t(self::class . '.KEY', 'fallback') — mutating the
                // key still returns the fallback string, making the mutation undetectable without
                // testing the i18n system itself
                ".*_t\\(.*",
                // i18n keys on separate lines from _t() call: ClassName::class . '.KEY'
                // is always an i18n key in SilverStripe; the fallback string is returned regardless
                ".*::class\\s*\\.\\s*'\\.[A-Z_]+'.*",
                // HTML element ID construction: $this->ID() . '_' . $optionValue
                // is template rendering data, not business logic
                ".*\\$this->ID\\(\\)\\s*\\.\\s*'_'.*",
            ],
        },
        "ConcatOperandRemoval": {
            ignoreSourceCodeByRegex: [
                ".*_t\\(.*",
                // i18n keys on separate lines (see Concat comment above)
                ".*::class\\s*\\.\\s*'\\.[A-Z_]+'.*",
                // Label concatenation in form option builders (e.g. $i . '/' . $columnCount)
                // produces display text only — mutations change the label format but not behavior
                ".*\\$i\\s*\\.\\s*'/'\\s*\\..*",
                // HTML element ID construction (see Concat comment above)
                ".*\\$this->ID\\(\\)\\s*\\.\\s*'_'.*",
            ],
        },
        "MethodCallRemoval": {
            ignoreSourceCodeByRegex: [
                // Extension point hooks: ->extend('updateX', $var) are contracts for third-party
                // code. Removing them has no effect without active extensions in test env.
                ".*->extend\\(.*",
                // Parent lifecycle calls (parent::onAfterWrite, parent::onBeforeWrite) are
                // framework contracts. Removing them breaks the lifecycle chain but tests
                // don't observe the parent's side effects directly.
                ".*parent::on(Before|After)Write\\(\\).*",
                // CMS form assembly: ->push(), ->displayIf(), ->setDescription(),
                // ->setFolderName(), ->setEmptyString() are UI wiring. Removing a single
                // push/decorator call produces a valid form missing one UI element — testing
                // every field exists is fragile UI testing, not business logic.
                ".*->push\\(.*",
                ".*->displayIf\\(.*",
                ".*->setDescription\\(.*",
                ".*->setFolderName\\(.*",
                ".*->setEmptyString\\(.*",
                ".*->addExtraClass\\(.*",
                // Versioned::set_stage(DRAFT) inside withVersionedMode closures: the test suite
                // sets DRAFT stage in setUp(), so the closure's stage call has no observable
                // effect. Removing it produces identical test behavior.
                ".*Versioned::set_stage\\(Versioned::DRAFT\\).*",
                // CMS field scaffolding removal (removeByName) — removing a scaffolded field
                // changes form UI, not business logic
                ".*->removeByName\\(.*",
                // CMS form field group setTitle — UI label only
                ".*->setTitle\\(_t\\(.*",
                // Info-level log calls are observability, not business logic. Tests use
                // NullLogger so removing these has no test-observable effect.
                ".*\\$this->logger->info\\(.*",
                // Auto-scaffold config toggling in migration finally blocks — framework
                // lifecycle management, not business logic. Effect is process-global and
                // invisible within a single test run.
                ".*config\\(\\)->set\\('auto_scaffold'.*",
                // Task CLI output (writeln) is user feedback, not business logic.
                // Tests assert return codes and DB state, not output text.
                ".*->writeln\\(.*",
            ],
        },
        // Private methods returning pure option arrays (aspect ratio labels, media position
        // labels, vertical alignment labels, gap size labels) are UI configuration.
        // Mutating individual array entries changes display labels, not behavior.
        "ArrayItem": {
            ignoreSourceCodeByRegex: [
                ".*=>\\s*_t\\(.*",
                ".*MediaPosition::.*=>\\s*_t\\(.*",
                ".*VerticalAlignment::.*=>\\s*_t\\(.*",
                ".*AspectRatio::.*=>\\s*_t\\(.*",
                // Template data keys for CMS rendering only (disabled state, percent display)
                ".*'isDisabled'\\s*=>.*",
                // Log context arrays — changing a context key/value has no effect on
                // business logic; logs are observability only
                ".*->logger->.*",
            ],
        },
        "ArrayItemRemoval": {
            ignoreSourceCodeByRegex: [
                ".*=>\\s*_t\\(.*",
                // Template data array entries (HTML element IDs, disabled state) —
                // only affect CMS rendering, not business logic
                ".*'ID'\\s*=>\\s*\\$this->ID\\(\\).*",
                // Log context arrays — removing one context key has no observable effect
                ".*->logger->.*",
            ],
        },
        "DecrementInteger": {
            ignoreSourceCodeByRegex: [
                // CMS conditional field visibility thresholds: ->displayIf('X')->isGreaterThan(0).
                // Changing 0 to -1 alters when a CMS field shows/hides — not business logic.
                ".*->isGreaterThan\\(\\d+\\).*",
                // CMS dropdown array key [0 => _t(...)] — option key is UI config data
                ".*\\[0\\s*=>\\s*_t\\(.*",
                // Error message format strings: $columnCount - 1 in sprintf produces a cosmetic
                // max-value for the user — the actual validation condition is unaffected
                ".*sprintf\\(.*\\$this->columnCount\\s*-\\s*1.*",
            ],
        },
        "IncrementInteger": {
            ignoreSourceCodeByRegex: [
                ".*->isGreaterThan\\(\\d+\\).*",
                ".*\\[0\\s*=>\\s*_t\\(.*",
                ".*sprintf\\(.*\\$this->columnCount\\s*-\\s*1.*",
                // round() precision arg in template percent — cosmetic display value
                ".*round\\(.*\\$contentPercent.*",
            ],
        },
        // FunctionalTest::setUp() calls SecurityToken::disable(), making the CSRF
        // guard in init() invisible to tests regardless of how it's mutated
        "NotIdentical": {
            ignoreSourceCodeByRegex: [
                ".*->httpMethod\\(\\)\\s*!==\\s*'GET'.*",
            ],
        },
        "Minus": {
            ignoreSourceCodeByRegex: [
                ".*sprintf\\(.*\\$this->columnCount\\s*-\\s*1.*",
            ],
        },
    },
    minMsi: 90,
    minCoveredMsi: 90,
}
