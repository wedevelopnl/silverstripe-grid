{
    "_comment": "Keep in sync with composer.fluent.json (adds Fluent dependency)",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "silverstripe/recipe-cms": "^6.0",
        "wedevelopnl/silverstripe-grid": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/module",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "_comment_require_dev": "QA toolchain is pinned to exact versions so CI's lock-less `composer install` cannot silently float into a rule/behavior change that breaks the build. Runtime deps (recipe-cms) stay on ranges so the module keeps testing against the latest SS6.x. Bump these manually when adopting a new tool release.",
    "require-dev": {
        "cambis/silverstan": "2.1.9",
        "infection/infection": "0.32.7",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.2.1",
        "phpstan/phpstan-deprecation-rules": "2.0.4",
        "phpunit/phpcov": "10.0.1",
        "phpunit/phpunit": "11.5.55",
        "rregeer/phpunit-coverage-check": "0.3.1",
        "tomasvotruba/type-coverage": "2.2.1",
        "wedevelopnl/silverstripe-e2e": "0.1.2",
        "wernerkrauss/silverstripe-rector": "1.3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WeDevelop\\Grid\\Tests\\": "vendor/wedevelopnl/silverstripe-grid/tests/"
        }
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
