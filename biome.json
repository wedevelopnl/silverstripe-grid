{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "client/js/**/*.js",
      "client/src/js/**/*.ts",
      "client/src/js/**/*.tsx",
      "client/src/js/**/*.js",
      "client/src/js/**/*.mjs",
      "client/src/js/**/*.cjs",
      "client/src/styles/**/*.css",
      "tests/E2E/**/*.ts",
      "scripts/**/*.mjs",
      "vite.config.mts",
      "vitest.setup.ts",
      "playwright.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useGenericFontNames": "error"
      },
      "complexity": {
        "noUselessUndefined": "error",
        "noUselessReturn": "error",
        "noImportantStyles": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noPlaywrightUselessAwait": "error",
        "noExcessiveSelectorClasses": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noNestedComponentDefinitions": "error",
        "noInvalidDirectionInLinearGradient": "error",
        "noInvalidGridAreas": "error",
        "noInvalidPositionAtImportRule": "error",
        "noMissingVarFunction": "error",
        "noUnknownFunction": "error",
        "noUnknownMediaFeatureName": "error",
        "noUnknownProperty": "error",
        "noUnknownPseudoClass": "error",
        "noUnknownPseudoElement": "error",
        "noUnknownTypeSelector": "error",
        "noUnknownUnit": "error",
        "noUnmatchableAnbSelector": "error",
        "noComponentHookFactories": "error",
        "noPlaywrightMissingAwait": "error"
      },
      "performance": {
        "noAwaitInLoops": "error",
        "noReExportAll": "error"
      },
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "useConsistentArrowReturn": "error",
        "noEnum": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noProcessEnv": "error",
        "useThrowOnlyError": "error",
        "noDescendingSpecificity": "error",
        "noHexColors": "error",
        "noValueAtRule": "error",
        "noPlaywrightElementHandle": "error",
        "noPlaywrightWaitForSelector": "error",
        "noPlaywrightEval": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error",
        "noDeprecatedImports": "error",
        "noUnusedExpressions": "error",
        "noDuplicateDependencies": "error",
        "noReactForwardRef": "error",
        "noConstantBinaryExpressions": "error",
        "noEvolvingTypes": "error",
        "useAwait": "error",
        "noSkippedTests": "error",
        "noExportsInTest": "error",
        "noMisplacedAssertion": "error",
        "noConsole": "warn",
        "noDuplicatedSpreadProps": "error",
        "noProto": "error",
        "noUnnecessaryConditions": "warn",
        "noShadow": "error",
        "useArraySortCompare": "error",
        "noDeprecatedMediaType": "error",
        "noDuplicateAtImportRules": "error",
        "noDuplicateCustomProperties": "error",
        "noDuplicateFontNames": "error",
        "noDuplicateProperties": "error",
        "noDuplicateSelectorsKeyframeBlock": "error",
        "noEmptyBlock": "error",
        "noImportantInKeyframe": "error",
        "noShorthandPropertyOverrides": "error",
        "noUnknownAtRules": "error",
        "noJsxLeakedDollar": "error",
        "noReactStringRefs": "error",
        "noIdenticalTestTitle": "error",
        "noConditionalExpect": "error",
        "noPlaywrightWaitForTimeout": "warn",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightForceOption": "error",
        "noPlaywrightWaitForNavigation": "error",
        "noPlaywrightPagePause": "error",
        "noDuplicateSelectors": "error",
        "useBaseline": {
          "level": "error",
          "options": {
            "available": "newly"
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noUnsafePlusOperands": "error",
        "noUselessTypeConversion": "error",
        "noImpliedEval": "error",
        "useAwaitThenable": "error",
        "useNullishCoalescing": "error",
        "noInvalidPropertyInitValue": "error"
      },
      "security": {
        "noScriptUrl": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["client/src/styles/tokens.css"],
      "linter": {
        "rules": {
          "style": {
            "noHexColors": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.js", "client/src/js/testing/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNestedComponentDefinitions": "off",
            "noComponentHookFactories": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "suspicious": {
            "noMisplacedAssertion": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/E2E/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "suspicious": {
            "noMisplacedAssertion": "off",
            "noSkippedTests": "off",
            "noConditionalExpect": "off"
          },
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["vite.config.mts", "vitest.setup.ts", "playwright.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "client/src/js/components/ConfirmDialog/ConfirmDialog.tsx",
        "client/src/js/components/DuplicateToDialog/DuplicateToDialog.tsx",
        "client/src/js/components/SharedBlockPickerDialog/SharedBlockPickerDialog.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
